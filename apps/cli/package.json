{
  "name": "@phoenix/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": { "phoenix": "dist/index.js" },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@phoenix/shared": "workspace:*",
    "@phoenix/core": "workspace:*",
    "@phoenix/ai": "workspace:*",
    "@phoenix/agent": "workspace:*",
    "@phoenix/tools": "workspace:*",
    "@phoenix/memory": "workspace:*",
    "commander": "^12.0.0",
    "chalk": "^5.3.0",
    "ora": "^8.0.0",
    "inquirer": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
